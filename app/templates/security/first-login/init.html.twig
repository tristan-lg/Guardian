{% extends '@!EasyAdmin/page/login.html.twig' %}

{% block page_title %}Initialiser votre mot de passe{% endblock %}

{% block header_logo %}
    {% if ea is defined and ea is not null %}
        <a class="logo logo-long text-center mb-3" title="Guardian" href="{{ path(ea.dashboardRouteName) }}">
            <img src="{{ asset('imgs/guardian_logo.png') }}" alt="Guardian">
        </a>
    {% else %}
        <div class="logo logo-long text-center mb-3 mt-3">
            <img src="{{ asset('imgs/guardian_logo.png') }}" alt="Guardian">
        </div>
    {% endif %}
{% endblock header_logo %}

{% block login_form_wrapper %}
    <h2 class="h4 mb-3">Initialiser votre mot de passe</h2>
    <p>Bienvenue sur <strong>{{ APP_NAME }}</strong>.</p>
    <p>
        Pour commencer, merci de choisir votre mot de passe :
    </p>

    {{ form_start(resetForm) }}

    <fieldset>
        <div class="mb-3">
            {{ form_widget(resetForm) }}
        </div>

        <div class="d-grid gap-2">
            <twig:ea:Button type="submit" variant="primary" size="lg" isBlock htmlAttributes="{class: 'btn-block'}">Enregistrer</twig:ea:Button>
        </div>
    </fieldset>
    {{ form_end(resetForm) }}
{% endblock %}
